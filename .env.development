# Development Environment (local PostgreSQL, no Docker)
# Kept on localhost intentionally so `npm run start:dev` works fully offline.
# Production/delivery uses Neon instead — see .env.production and the root .env
# (the latter is what `npx prisma migrate` / `studio` read by default).
NODE_ENV=development
PORT=3000
APP_NAME=Oxtore
API_PREFIX=api

# Database (PostgreSQL running locally)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oxtore?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oxtore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Redis (optional - app runs fine without it)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Storage / MinIO (optional - app runs fine without it)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oxtore
MINIO_USE_SSL=false

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Email OTP — 'ethereal' auto-provisions a free test inbox at boot (no signup needed,
# logs a preview link per email, not real delivery). Switch to 'gmail' or 'mailtrap'
# and fill in the matching credentials below for real delivery to a real inbox.
MAIL_PROVIDER=ethereal
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
MAILTRAP_HOST=
MAILTRAP_PORT=587
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_FROM_EMAIL=noreply@oxtore.com
MAIL_FROM_NAME=Oxtore

# WhatsApp OTP (optional - falls back to console logging if unset)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=debug

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
