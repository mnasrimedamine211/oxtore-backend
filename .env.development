# Development Environment
NODE_ENV=development
PORT=3000
APP_NAME=Oxtore
API_PREFIX=api

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oxtore_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oxtore_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

MAIL_PROVIDER=gmail
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
MAIL_FROM_EMAIL=noreply@oxtore.com
MAIL_FROM_NAME=Oxtore

WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oxtore
MINIO_USE_SSL=false

CORS_ORIGIN=*
LOG_LEVEL=debug

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
