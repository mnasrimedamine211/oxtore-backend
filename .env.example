# ============================================
# Oxtore Backend - Environment Configuration
# ============================================
# Copy this file to .env.development, .env.test, or .env.production
# and fill in the appropriate values.

# Application
NODE_ENV=development
PORT=3000
APP_NAME=Oxtore
API_PREFIX=api

# Database (local PostgreSQL, no Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oxtore
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oxtore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-secure-secret-in-production
JWT_REFRESH_SECRET=change-this-to-a-secure-refresh-secret-in-production
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Mail (Gmail SMTP or Mailtrap)
MAIL_PROVIDER=gmail
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
MAILTRAP_HOST=
MAILTRAP_PORT=587
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_FROM_EMAIL=noreply@oxtore.com
MAIL_FROM_NAME=Oxtore

# WhatsApp (Twilio Sandbox or Meta Cloud API)
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=

# Storage (MinIO / S3 compatible)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oxtore
MINIO_USE_SSL=false

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
