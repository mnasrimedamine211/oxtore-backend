# Local override file — loaded only if you explicitly point envFilePath at it.
# NestJS loads .env.<NODE_ENV> by default (see .env.development for local dev).
NODE_ENV=development
PORT=3000
APP_NAME=Oxtore
API_PREFIX=api

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oxtore?schema=public
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oxtore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000

CORS_ORIGIN=*
LOG_LEVEL=debug
