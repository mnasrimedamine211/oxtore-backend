# Root env file. NestJS runtime loads .env.<NODE_ENV> instead (see .env.development
# for local Postgres) — but the Prisma CLI (migrate/studio/db push/generate) always
# reads THIS file by default, regardless of NODE_ENV. It's pinned to Neon so that
# `npx prisma migrate deploy` / `npx prisma studio` target the delivered database
# by default. Local app development still runs against local Postgres via
# .env.development — see that file to work fully offline.
NODE_ENV=development
PORT=3000
APP_NAME=Oxtore
API_PREFIX=api

DATABASE_URL=postgresql://neondb_owner:npg_SluCH1Gd3VIx@ep-quiet-poetry-astexg7v.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_HOST=ep-quiet-poetry-astexg7v.c-4.eu-central-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=npg_SluCH1Gd3VIx

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

REDIS_HOST=localhost
REDIS_PORT=6379

MINIO_ENDPOINT=localhost
MINIO_PORT=9000

CORS_ORIGIN=*
LOG_LEVEL=debug
