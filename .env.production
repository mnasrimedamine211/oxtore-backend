# Production Environment - CHANGE ALL VALUES
NODE_ENV=production
PORT=3000
APP_NAME=Oxtore
API_PREFIX=api

DATABASE_URL=postgresql://USER:PASSWORD@PRODUCTION_HOST:5432/oxtore_prod
POSTGRES_HOST=PRODUCTION_HOST
POSTGRES_PORT=5432
POSTGRES_DB=oxtore_prod
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

REDIS_HOST=PRODUCTION_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

JWT_SECRET=CHANGE_TO_A_VERY_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_TO_A_DIFFERENT_VERY_LONG_RANDOM_SECRET
JWT_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

GOOGLE_CLIENT_ID=YOUR_PRODUCTION_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_PRODUCTION_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

MAIL_PROVIDER=mailtrap
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=
MAILTRAP_HOST=
MAILTRAP_PORT=587
MAILTRAP_USER=
MAILTRAP_PASS=
MAIL_FROM_EMAIL=noreply@your-domain.com
MAIL_FROM_NAME=Oxtore

WHATSAPP_PROVIDER=meta
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
META_WHATSAPP_TOKEN=YOUR_PRODUCTION_META_TOKEN
META_PHONE_NUMBER_ID=YOUR_PRODUCTION_PHONE_NUMBER_ID

MINIO_ENDPOINT=PRODUCTION_STORAGE_HOST
MINIO_PORT=9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD
MINIO_BUCKET=oxtore-prod
MINIO_USE_SSL=true

CORS_ORIGIN=https://your-domain.com
LOG_LEVEL=warn

RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
